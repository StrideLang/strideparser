use DesktopAudio version 1.0

loop LoopIn {
    ports: [
        mainInputPort InputPort {
            entity: Input
        }
    ]
    entities: [
        switch CounterReset {default: on}
    ]
    streams: [
        Input >> Internal;
    ]
    terminateWhen: CounterReset
}

loop LoopOut {
    ports: [
        mainOutputPort OutputPort {
            entity: Output
        }
    ]
    entities: [
        switch CounterReset {default: on}
    ]
    streams: [
        10 >> Output;
    ]
    terminateWhen: CounterReset
}

loop LoopInOut {
    ports: [
        mainOutputPort OutputPort {
            entity: Output
        }
        mainInputPort InputPort {
            entity: Input
        }
    ]
    entities: [
        switch CounterReset {default: on}
    ]
    streams: [
        Input >> Output;
    ]
    terminateWhen: CounterReset
}

module ContainsLoop {
    ports: [
        mainOutputPort OutputPort {
            entity: Output
        }
        mainInputPort InputPort {
            entity: Input
        }
    ]
    entities: [
        loop InModule {
            entities: [
                switch CounterReset {default: on}
            ]
            ports: [
                mainOutputPort OutputPort {
                    entity: Output
                }
            ]
            streams: [
                25 >> Output;
            ]
            terminateWhen: CounterReset
        }
        loop InModuleInput {
            entities: [
                switch CounterReset {default: on}
                signal Internal {}
            ]
            ports: [
                mainInputPort InputPort {
                    entity: Input
                }
            ]
            streams: [
                Input >> Internal;
            ]
            terminateWhen: CounterReset
        }
    ]
    streams: [
        InModule() >> Output;
        Input >> InModuleInput();
    ]
}



