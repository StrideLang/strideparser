use DesktopAudio version 1.0

module SimpleTest {
    ports: [
        mainInputPort InputPort {
            name: 'input'
            entity: Input
        },
        mainOutputPort OutputPort {
            name: 'output'
            entity: Output
        }
    ]
    entities: [
    ]
    streams: [
        Input >> Output;
    ]
}

signal InSignal { domain: AsyncDomain }
signal OutSignal { domain: AudioDomain }

InSignal >> SimpleTest() >> OutSignal;

