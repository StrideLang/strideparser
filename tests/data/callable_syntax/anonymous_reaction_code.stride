module CounterCode {
    ports: [
        mainOutputPort OutputPort { entity: Output }
    ]
    entities: [
        signal Output { default: 0 },
        signal StopValue { default: 10 },
        signal StartValue { default: 0 }
    ]
    streams: [
        [Output, StopValue] >> Greater() >> reaction {
            code: [
                signal Temp { default: 1 }
                StartValue + Temp >> Output;
            ]
        };
    ]
}
